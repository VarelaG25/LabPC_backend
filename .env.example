# Puerto del API
PORT=4000

# Dónde se guardan los datos:
#   mongo  -> en MongoDB (necesita MONGODB_URI). Las colecciones vacías se llenan con datos de ejemplo.
#   memory -> en memoria; se pierden al reiniciar el servidor.
DATA_SOURCE=mongo

# Conexión a MongoDB (local o en la nube)
MONGODB_URI=mongodb://localhost:27017/labpc
