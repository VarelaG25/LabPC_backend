{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["Application/**/*.ts", "BLL/**/*.ts", "DLL/**/*.ts", "Domain/**/*.ts", "LabPC/**/*.ts", "LabPC_BL/**/*.ts"],
  "exclude": ["node_modules", "dist", "TEST"]
}
